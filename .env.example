# Local development only; use matching credentials in DATABASE_URL.
POSTGRES_USER=support
POSTGRES_PASSWORD=support_dev_password
POSTGRES_DB=support
# Change only this host port if a native database already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://support:support_dev_password@postgres:5432/support
AGENT_BASE_URL=http://agent:8000
ORDERS_BASE_URL=http://orders:8000
REFUNDS_BASE_URL=http://refunds:8000
APPROVALS_BASE_URL=http://approvals:8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
# Browser URL, not a Compose DNS name.
VITE_GATEWAY_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
WORKER_CHECK_INTERVAL=5
# Optional host port override; add its origin to CORS_ORIGINS if changed.
OPERATOR_WEB_PORT=3001
